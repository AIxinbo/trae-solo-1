# ============================================================
# 数智绿茵 部署环境变量
# 复制为 .env 并按需修改，所有 compose 文件共享此文件
# ============================================================

# ---------- 项目 ----------
PROJECT_PREFIX=football

# ---------- 镜像仓库（生产用） ----------
REGISTRY=registry.cn-shanghai.aliyuncs.com
IMAGE_TAG=v1.0

# ---------- PostgreSQL ----------
DB_USER=football
DB_PASS=football@2026
DB_NAME=football_db
PG_PORT=5432

# ---------- Redis ----------
REDIS_PASS=redis@2026
REDIS_PORT=6379

# ---------- MinIO ----------
MINIO_ROOT_USER=admin
MINIO_ROOT_PASS=minio@2026
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------- Milvus ----------
MILVUS_PORT=19530

# ---------- 后端 Java ----------
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ---------- AI Python ----------
AI_PORT=8000

# ---------- 前端 ----------
FRONTEND_PORT=5173

# ---------- Nginx ----------
NGINX_PORT=80
NGINX_HTTPS_PORT=443

# ---------- JWT ----------
JWT_SECRET=please-change-this-secret-in-production
JWT_EXPIRE=86400

# ---------- 时区 ----------
TZ=Asia/Shanghai
