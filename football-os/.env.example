# ============================================================
# football-os 前端环境变量示例
# 复制为 .env.development / .env.production 并按需修改
# ============================================================

# API 基础路径（开发环境走 vite proxy，生产环境走 nginx）
VITE_API_BASE_URL=/api/v1
VITE_AI_API_BASE_URL=/api/v1/ai

# 开发环境后端直连地址（仅 vite.config.ts 的 proxy 使用）
VITE_BACKEND_URL=http://localhost:8080
VITE_AI_URL=http://localhost:8000

# 应用元信息
VITE_APP_TITLE=数智绿茵
VITE_APP_VERSION=0.1.0
